interrupt {
    let s = read_word(0x80)
    let target_addr = 0x4000 + count
    print_word(s, target_addr)
    count = count+4
}
let len = read_word(0x4000)
let st_addr = 0x4004
let cur_ad = st_addr
let i_0 = 0
let i_1 = 0
let digit = 0
let min = 0xffffffff
while(i_0 < len){
    cur_ad = st_addr
    min = 0xffffffff
    i_1 = 0
    while (i_1 < len){
        digit = read_word(cur_ad)
        if (digit<min){
            min = digit
        }
        cur_ad = cur_ad + 4
        i_1 = i_1 + 1
    }
    print_word(min, 0x84)
    i_1 = 0
    cur_ad = st_addr
    while (i_1 < len){
        digit = read_word(cur_ad)
        if (digit==min){
            print_word(0xffffffff, cur_ad)
            break
        }
        cur_ad = cur_ad + 4
        i_1 = i_1 + 1
    }
   i_0 = i_0 + 1

}