interrupt {
  let s = read_byte(0x80)
  print_byte(s, 0x4000 + count)
  count = count + 1
}
let len = read_byte(0x4000)
let st_addr = 0x4001
let cur_ad = st_addr
let i_0 = 0
let i_1 = 0
let digit = 0
let min = 0xff
while(i_0 < len){
    cur_ad = st_addr
    min = 0xff
    i_1 = 0
    while (i_1 < len){
        digit = read_byte(cur_ad)
        if (digit < min){
            min = digit
        }
        cur_ad = cur_ad + 1
        i_1 = i_1 + 1
    }
    print_byte(min, 0x84)
    i_1 = 0
    cur_ad = st_addr
    while (i_1 < len){
        digit = read_byte(cur_ad)
        if (digit == min){
            print_byte(0xff, cur_ad)
            break
        }
        cur_ad = cur_ad + 1
        i_1 = i_1 + 1
    }
  i_0 = i_0 + 1

}
